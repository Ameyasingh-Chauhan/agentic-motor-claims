utralPercentage\":4.97512,\"totalWeightedSocialReviewsHelpfulnessBuyPercentage\":7.46269,\"totalWeightedSocialReviewsHelpfulnessNeutralPercentage\":13.4328,\"avgRecommendToFamily\":0,\"avgRatingMaintenanceCost\":0,\"avgRatingExteriorLooks\":0,\"avgRatingFuelEconomy\":0,\"avgRatingFuelEconomyCity\":0,\"avgRatingEvKmRange\":0,\"avgRatingComfort\":0,\"avgRatingDrivingExperience\":0,\"avgRatingPerformance\":0,\"avgRatingValueForMoney\":0,\"oldCars24Id\":44050,\"contentTagIds\":[],\"isRatingPage\":false},\"recentlyLaunchedModels\":[{\"id\":1508,\"name\":\"42 FJ\",\"slug\":\"42-fj\",\"launchStatus\":\"Launched\",\"makeModelSlug\":\"jawa-42-fj\",\"launchedDate\":\"2026-08-25\",\"minPriceInLakh\":2.01942,\"maxPriceInLakh\":2.15942,\"bikeImage\":{\"caption\":\"\",\"alternativeText\":\"Vector Bike Image\",\"url\":\"https://static-cdn.team-bhp.com/prod/bikes/2025/06/04/Color-Image-Bike-0f3c001b-7d89-4d8b-ace7-ab4f3a682a69.png\"},\"make\":{\"id\":25,\"name\":\"Jawa\",\"slug\":\"jawa\",\"isActive\":true},\"featureImage\":{\"caption\":\"\",\"alternativeText\":\"Vector Images\",\"url\":\"https://static-cdn.team-bhp.com/prod/bikes/2025/06/04/Feature-Image-Bike-a55e8311-0a2c-4341-b070-7ea11ceef77e.jpg\"},\"productType\":\"NEW_BIKES\"}],\"similarModels\":[{\"id\":12,\"name\":\"Meteor 350\",\"slug\":\"meteor-350\",\"launchStatus\":\"Launched\",\"makeModelSlug\":\"royal-enfield-meteor-350\",\"minPriceInLakh\":2.05528,\"maxPriceInLakh\":2.29802,\"bikeImage\":{\"url\":\"https://static-cdn.team-bhp.com/prod/new-bike-cms/Royal-Enfield/Meteor-350/2025/01/03/0ce6ae6b-babf-49fa-8cb7-c97326448543-Royal-Enfield_Meteor-350_Bike-Image.png\"},\"make\":{\"id\":40,\"name\":\"Royal Enfield\",\"slug\":\"royal-enfield\",\"isActive\":true},\"featureImage\":{\"url\":\"https://static-cdn.team-bhp.com/prod/new-bike-cms/Royal-Enfield/Meteor-350/2025/01/01/e58cc69f-0c3f-4fff-b903-b612ac2526e0-Royal-Enfield_Meteor-350_Feature-Image.png\"},\"baseVariantId\":28,\"baseVariantName\":\"Fireball\",\"baseVariantSlug\":\"royal-enfield-meteor-350-fireball\",\"isElectric\":false,\"overallSummary\":\"The Royal Enfield Meteor 350 is well-regarded for its **comfortable ride**, **classic styling**, and **refined engine performance**, making it a solid choice for cruisers. Reviewers appreciate its decent fuel efficiency and modern features like Tripper Navigation. However, concerns about its **inadequate suspension**, **limited top speed**, and **vibrations at higher speeds** are noted. While it excels on smooth roads, potential buyers should be cautious about its handling on rough surfaces and overall power limitations.\",\"overallScore\":78.56},{\"id\":108,\"name\":\"CB350\",\"slug\":\"cb350\",\"launchStatus\":\"Launched\",\"makeModelSlug\":\"honda-cb350\",\"minPriceInLakh\":1.9999,\"maxPriceInLakh\":2.18951,\"bikeImage\":{\"url\":\"https://static-cdn.team-bhp.com/prod/new-bike-cms/Honda/Cb350/2025/01/03/e1675fad-2dc4-4729-bec1-849697796368-Honda_Cb350_Bike-Image.png\"},\"make\":{\"id\":32,\"name\":\"Honda\",\"slug\":\"honda\",\"isActive\":true},\"featureImage\":{\"url\":\"https://static-cdn.team-bhp.com/prod/new-bike-cms/Honda/Cb350/2025/01/01/f6deade8-32ae-4435-8496-87fd893500c5-Honda_Cb350_Feature-Image.png\"},\"baseVariantId\":228,\"baseVariantName\":\"DLX\",\"baseVariantSlug\":\"honda-cb350-dlx\",\"isElectric\":false,\"overallSummary\":\"The Honda CB350 is well-regarded for its **sporty styling** and **refined engine**, offering a smooth ride and comfort, making it ideal for new riders. Users appreciate its **feature-rich design** and **impressive fuel efficiency** for both city and highway use. However, some concerns include **rust issues**, **subpar braking performance**, and **higher pricing** compared to competitors, along with a limited service network that may impact maintenance accessibility.\",\"overallScore\":76},{\"id\":105,\"name\":\"Hness CB350\",\"slug\":\"hness-cb350\",\"launchStatus\":\"Launched\",\"makeModelSlug\":\"honda-hness-cb350\",\"minPriceInLakh\":2.10601,\"maxPriceInLakh\":2.15601,\"bikeImage\":{\"url\":\"https://static-cdn.team-bhp.com/prod/new-bike-cms/Honda/Hness-Cb350/2025/01/03/c691271e-8a92-490d-ae8e-8eafabc8578e-Honda_Hness-Cb350_Bike-Image.png\"},\"make\":{\"id\":32,\"name\":\"Honda\",\"slug\":\"honda\",\"isActive\":true},\"featureImage\":{\"url\":\"https://static-cdn.team-bhp.com/prod/new-bike-cms/Honda/Hness-Cb350/2025/01/01/d5e21ccc-8823-468d-86e6-f93bd89495e1-Honda_Hness-Cb350_Feature-Image.png\"},\"baseVariantId\":221,\"baseVariantName\":\"DLX\",\"baseVariantSlug\":\"honda-hness-cb350-dlx\",\"isElectric\":false,\"overallSummary\":\"The Honda CB350 is widely praised for its **smooth performance**, **excellent handling**, and **impressive fuel efficiency**, with users reporting mileage around 33-38 kmpl. Reviewers highlight its **solid build quality** and **comfortable seating**, along with modern features like Bluetooth and traction control. However, concerns include a **weak headlight throw**, **challenging gear travel in traffic**, and potential **rusting issues** if not maintained properly. Despite these drawbacks, many express satisfaction with the bike's overall performance.\",\"overallScore\":78.7778},{\"id\":112,\"name\":\"CB350RS\",\"slug\":\"cb350rs\",\"launchStatus\":\"Launched\",\"makeModelSlug\":\"honda-cb350rs\",\"minPriceInLakh\":2.15601,\"maxPriceInLakh\":2.18601,\"bikeImage\":{\"url\":\"https://static-cdn.team-bhp.com/prod/new-bike-cms/Honda/Cb350Rs/2025/01/03/44f6f980-425a-420c-b2ef-471f6f1e7b43-Honda_Cb350Rs_Bike-Image.png\"},\"make\":{\"id\":32,\"name\":\"Honda\",\"slug\":\"honda\",\"isActive\":true},\"featureImage\":{\"url\":\"https://static-cdn.team-bhp.com/prod/new-bike-cms/Honda/Cb350Rs/2025/01/01/c67c9c33-6bd4-492c-a13e-83e013bd7167-Honda_Cb350Rs_Feature-Image.png\"},\"baseVariantId\":236,\"baseVariantName\":\"DLX\",\"baseVariantSlug\":\"honda-cb350rs-dlx\",\"isElectric\":false,\"overallSummary\":\"This review highlights positive aesthetics but contains irrelevant content, making it unsuitable for processing.\",\"overallScore\":0},{\"id\":64,\"name\":\"Roadster\",\"slug\":\"roadster\",\"launchStatus\":\"Launched\",\"makeModelSlug\":\"yezdi-roadster\",\"minPriceInLakh\":2.07974,\"maxPriceInLakh\":2.14997,\"bikeImage\":{\"url\":\"https://static-cdn.team-bhp.com/prod/new-bike-cms/Yezdi/Roadster/2025/01/03/9b76adc1-842c-40ed-ae01-747d3798455d-Yezdi_Roadster_Bike-Image.png\"},\"make\":{\"id\":36,\"name\":\"Yezdi\",\"slug\":\"yezdi\",\"isActive\":true},\"featureImage\":{\"url\":\"https://static-cdn.team-bhp.com/prod/new-bike-cms/Yezdi/Roadster/2025/01/01/bda74557-68c5-470d-8201-b68184f32a65-Yezdi_Roadster_Feature-Image.png\"},\"baseVariantId\":131,\"baseVariantName\":\"Smoke Grey - Inferno Red - Glacial White\",\"baseVariantSlug\":\"yezdi-roadster-smoke-grey-inferno-red-glacial-white\",\"isElectric\":false,\"overallSummary\":\"The Yezdi Roadster combines classic charm with modern reliability, featuring a retro design and a robust engine for impressive performance. Its nimble handling makes city driving easy. However, potential buyers should consider concerns about maintenance costs and spare parts availability.\",\"overallScore\":56}],\"upcomingModels\":[{\"id\":1471,\"name\":\"F 450 GS\",\"slug\":\"f-450-gs\",\"launchStatus\":\"Upcoming\",\"makeModelSlug\":\"bmw-f-450-gs\",\"minPriceInLakh\":4.5,\"maxPriceInLakh\":4.5,\"estimatedLaunchedDate\":\"2026-01-28\",\"featureVideoURL\":\"https://www.youtube.com/embed/HSLf4vBXO44?si=Gygy53BvqtIx0I0f\",\"bikeImage\":{\"caption\":\"Bike Image\",\"alternativeText\":\"Bike Image\",\"url\":\"https://static-cdn.team-bhp.com/prod/vehicles/bmw/f-450-gs/bike-image-2-Re56LM2t6mQSRh1o.png\"},\"make\":{\"id\":45,\"name\":\"BMW\",\"slug\":\"bmw\",\"isActive\":true},\"featureImage\":{\"caption\":\"Feature Image\",\"alternativeText\":\"Feature Image\",\"url\":\"https://static-cdn.team-bhp.com/prod/vehicles/bmw/f-450-gs/feature-image-1-AEHl6aVDvKSwA13V.png\"},\"featureVideoStartTime\":\"00:00:00\",\"featureVideoEndTime\