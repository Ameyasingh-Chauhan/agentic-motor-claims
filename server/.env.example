APP_NAME=Agentic Motor Claims
INSURER_NAME=ABC General Insurance
# quick-login tiles, demo scenario loader, Dev Tools reset
DEMO_MODE=true
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_MINUTES=480

# Gemini on Vertex AI (Gemini Enterprise Agent Platform)
# The user places the service-account JSON key in server/credentials/ (path relative to /server).
GOOGLE_APPLICATION_CREDENTIALS=credentials/vertex-key.json
# If blank, project_id is read from the key file.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.7-flash
GEMINI_TIMEOUT_SECONDS=45
GEMINI_MAX_RETRIES=3

# auto | live | demo   (auto = live, fall back to demo on failure)
LLM_MODE=auto
# Presentation-mode pacing; Fast mode ignores it
PIPELINE_MIN_STEP_MS=1200
CORS_ORIGINS=http://localhost:5173
